{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(clasp *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/clasp-deploy-reminder.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gs-syntax-check.sh\""
          }
        ]
      }
    ]
  }
}
